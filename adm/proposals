<script>
  // Date in header
  const d = new Date();
  document.getElementById('today').textContent = d.toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'});

  // Toggle comments panel
  function toggleComments(panelId, rowEl) {
    const panel = document.getElementById(panelId);
    const arrow = rowEl.querySelector('.toggle-arrow');
    const isVisible = panel.classList.contains('visible');
    panel.classList.toggle('visible', !isVisible);
    arrow.classList.toggle('open', !isVisible);
  }
</script>

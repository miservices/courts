<script>
  // ── CONFIG ──
  const ROBLOX_CLIENT_ID = '6125371219815664523';
  const REDIRECT_URI     = 'https://miservices.github.io/micourt/account/';
  const WORKER_URL       = 'https://roblox-oauth.takosull0.workers.dev/';

  // ── SESSION STORAGE KEYS ──
  const SS_STATE    = 'micourt_oauth_state';
  const SS_REDIRECT = 'micourt_post_login_redirect';

  // ── UI helpers ──
  function showLoading(title, msg) {
    hide('statusError'); hide('userCard'); hide('notCitizenCard');
    document.getElementById('loadingTitle').textContent = title || 'Verifying…';
    document.getElementById('loadingMsg').textContent   = msg   || 'Please wait.';
    show('statusLoading');
    disable('signinBtn');
    document.getElementById('providerSection').style.opacity = '0.4';
    document.getElementById('providerSection').style.pointerEvents = 'none';
  }

  function showError(msg) {
    hide('statusLoading'); hide('userCard'); hide('notCitizenCard');
    document.getElementById('errorMsg').textContent = msg;
    show('statusError');
    enable('signinBtn');
    showEl('retryBtn');
    document.getElementById('providerSection').style.opacity = '1';
    document.getElementById('providerSection').style.pointerEvents = '';
  }

  function showUserCard(username, sin) {
    hide('statusLoading'); hide('statusError');
    document.getElementById('ucUsername').textContent = username;
    document.getElementById('ucSin').textContent      = 'SIN: ' + sin;
    show('userCard');
  }

  function showNotCitizen() {
    hide('statusLoading');
    show('notCitizenCard');
    hideEl('signinBtn');
    showEl('retryBtn');
  }

  function show(id)    { document.getElementById(id).classList.add('show'); }
  function hide(id)    { document.getElementById(id).classList.remove('show'); }
  function showEl(id)  { document.getElementById(id).classList.remove('hidden'); }
  function hideEl(id)  { document.getElementById(id).classList.add('hidden'); }
  function disable(id) { document.getElementById(id).disabled = true; }
  function enable(id)  { document.getElementById(id).disabled = false; }

  // ── Boot: activate the sign-in button once page is ready ──
  window.addEventListener('DOMContentLoaded', () => {
    enable('signinBtn');
    handleOAuthCallback();
  });

  // ── STEP 1: kick off Roblox OAuth ──
  function initRobloxLogin() {
    const state = crypto.randomUUID();
    sessionStorage.setItem(SS_STATE, state);

    const params = new URLSearchParams({
      client_id:     ROBLOX_CLIENT_ID,
      redirect_uri:  REDIRECT_URI,
      response_type: 'Code',
      scope:         'openid profile',
      state,
    });
    window.location.href = 'https://authorize.roblox.com/?' + params.toString();
  }

  // ── STEP 2: handle redirect back from Roblox ──
  async function handleOAuthCallback() {
    const params     = new URLSearchParams(window.location.search);
    const code       = params.get('code');
    const stateParam = params.get('state');
    const savedState = sessionStorage.getItem(SS_STATE);

    if (!code) return; // normal page load, nothing to do

    // Clean URL
    window.history.replaceState({}, '', window.location.pathname);
    sessionStorage.removeItem(SS_STATE);

    // Validate state
    if (stateParam !== savedState) {
      showError('Security validation failed (state mismatch). Please try signing in again.');
      return;
    }

    showLoading('Exchanging authorization code…', 'Contacting the SOS identity service. This may take a moment.');

    try {
      // Exchange code for user info via Worker (same worker as SOS uses)
      const res  = await fetch(WORKER_URL, {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ code }),
      });
      const data = await res.json();

      if (!data.userId || !data.username) {
        throw new Error(data.error || data.detail?.error_description || 'Could not retrieve Roblox account details.');
      }

      await verifyWithRegistry(data.userId, data.username);

    } catch (err) {
      showError('Connection failed: ' + (err.message || 'Unknown error. Please try again.'));
    }
  }

  // ── STEP 3: look up citizen in SOS registry ──
  async function verifyWithRegistry(robloxId, username) {
    showLoading('Checking SOS identity registry…', 'Looking up your citizenship record with the Secretary of State.');

    // Wait for Firebase
    if (!window._firebaseReady) {
      await new Promise(resolve => document.addEventListener('firebaseReady', resolve, { once: true }));
    }

    const { collection, getDocs, query, where } = window._firestoreHelpers;
    const db = window._sosDb;

    try {
      // Query the "registry" collection for an approved citizen with this roblox ID
      const regRef = collection(db, 'registry');
      const q = query(
        regRef,
        where('robloxId', '==', String(robloxId)),
        where('status',   '==', 'approved')
      );
      const snap = await getDocs(q);

      if (snap.empty) {
        // Not found as approved — also check "applications" for clarity
        const appsRef = collection(db, 'applications');
        const appQ = query(
          appsRef,
          where('robloxId', '==', String(robloxId))
        );
        const appSnap = await getDocs(appQ);

        // Show the user card so they know we found their Roblox account
        showUserCard(username, robloxId);
        showNotCitizen();
        return;
      }

      // Found — citizen approved
      const citizenDoc  = snap.docs[0].data();
      const displayName = citizenDoc.fullName || citizenDoc.firstName
        ? [citizenDoc.firstName, citizenDoc.lastName].filter(Boolean).join(' ')
        : username;

      showUserCard(username, robloxId);
      showLoading('Identity confirmed. Signing you in…', 'Welcome, ' + displayName + '. Redirecting to your dashboard.');

      // Store session info
      sessionStorage.setItem('micourt_user', JSON.stringify({
        robloxId:    String(robloxId),
        username,
        sin:         citizenDoc.sin || String(robloxId),
        fullName:    displayName,
        citizenData: citizenDoc,
        loginAt:     new Date().toISOString(),
      }));

      // Redirect to dashboard
      setTimeout(() => {
        const dest = sessionStorage.getItem(SS_REDIRECT) || '/micourt/dashboard/';
        sessionStorage.removeItem(SS_REDIRECT);
        window.location.href = dest;
      }, 1200);

    } catch (err) {
      console.error('Registry lookup error:', err);
      showError('Could not connect to the SOS identity registry: ' + (err.message || 'Please try again.'));
    }
  }

  // ── Reset back to initial state ──
  function resetLogin() {
    hide('statusLoading');
    hide('statusError');
    hide('userCard');
    hide('notCitizenCard');
    hideEl('retryBtn');
    showEl('signinBtn');
    enable('signinBtn');
    document.getElementById('providerSection').style.opacity = '1';
    document.getElementById('providerSection').style.pointerEvents = '';
  }

  // Expose to global
  window.initRobloxLogin = initRobloxLogin;
  window.resetLogin      = resetLogin;
</script>


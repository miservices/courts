    <div class="header-nav">
      <a href="/micourt/">Home</a>
      <a href="/micourt/cases/">Case Search</a>
      <a href="/micourt/help/">Help</a>
      <a class="nav-cta" href="/micourt/account/">Sign In</a>
    </div>
  </div>
</div>

<div class="page-wrap">
  <div class="login-shell">

    <!-- Left branding panel -->
    <div class="login-left">
      <div class="ll-top">
        <div class="ll-seal">⚖️</div>
        <div class="ll-title">Michigan Court Online Portal</div>
        <p class="ll-desc">MiCOURT is the official online portal for the Michigan Court system, maintained by the State Court Administrative Office (SCAO). Sign in to access your case records, filings, and court services.</p>
        <hr class="ll-divider">
        <div class="ll-features">
          <div class="ll-feat">
            <div class="ll-feat-icon">📋</div>
            <div class="ll-feat-text">
              <strong>Your Cases</strong>
              <span>View cases you are a party to, track hearing dates, and monitor case status.</span>
            </div>
          </div>
          <div class="ll-feat">
            <div class="ll-feat-icon">📄</div>
            <div class="ll-feat-text">
              <strong>E-Filing</strong>
              <span>Submit documents and filings directly to the clerk's office electronically.</span>
            </div>
          </div>
          <div class="ll-feat">
            <div class="ll-feat-icon">💳</div>
            <div class="ll-feat-text">
              <strong>Fines &amp; Fees</strong>
              <span>Pay outstanding court fines, fees, and financial obligations online.</span>
            </div>
          </div>
        </div>
      </div>
      <p class="ll-bottom">Authentication is provided through the Michigan Secretary of State identity registry. Your identity and citizenship status are verified against official SOS records.</p>
    </div>

    <!-- Right login panel -->
    <div class="login-right">
      <div class="lr-header">
        <h2>Sign In to MiCOURT</h2>
        <p>MiCOURT uses the Michigan Secretary of State identity system to verify your identity. Sign in with your Roblox account — the same one linked to your SOS record.</p>
      </div>

      <!-- Auth provider selector -->
      <div class="auth-provider" id="providerSection">
        <div class="ap-label">Sign in with</div>
        <div class="ap-card" id="sosProviderCard" onclick="initRobloxLogin()">
          <div class="ap-logo">🏛️</div>
          <div class="ap-info">
            <strong>Michigan Secretary of State</strong>
            <span>Verify via your SOS Roblox account &amp; identity registry</span>
          </div>
          <span class="ap-arrow">›</span>
        </div>
      </div>

      <!-- Status: loading -->
      <div class="status-box loading" id="statusLoading">
        <div class="spin-sm"></div>
        <div class="sb-body">
          <strong id="loadingTitle">Connecting to SOS registry…</strong>
          <p id="loadingMsg">Please wait while we verify your identity.</p>
        </div>
      </div>

      <!-- Status: error -->
      <div class="status-box error" id="statusError">
        <span class="sb-icon">⚠️</span>
        <div class="sb-body">
          <strong>Sign-In Failed</strong>
          <p id="errorMsg">Something went wrong. Please try again.</p>
        </div>
      </div>

      <!-- Connected user card (shown when Roblox verified) -->
      <div class="user-card" id="userCard">
        <div class="uc-avatar">🎮</div>
        <div class="uc-info">
          <strong id="ucUsername">—</strong>
          <span id="ucSin">SIN: —</span>
        </div>
        <span class="uc-verified">Verified</span>
      </div>

      <!-- Not-a-citizen state -->
      <div class="not-citizen-card" id="notCitizenCard">
        <div class="ncc-inner">
          <div class="ncc-icon">🚧</div>
          <h3>Citizen Account Required</h3>
          <p>MiCOURT accounts are available to Michigan citizens. Your Roblox account was not found in the Secretary of State identity registry as an approved citizen.</p>
          <div class="ncc-dev-badge">🔧 Still Under Development</div>
          <p style="font-size:11.5px;color:#92400e;">Non-citizen account access is coming soon. In the meantime, you must be an approved Michigan citizen to access the MiCOURT portal.</p>
          <br>
          <a class="ncc-apply-btn" href="/sos/citizenship/apply/">Apply for Citizenship →</a>
          <button class="ncc-disconnect" onclick="resetLogin()">Sign in with a different account</button>
        </div>
      </div>

      <!-- Primary CTA -->
      <button class="signin-btn" id="signinBtn" onclick="initRobloxLogin()" disabled>
        <span>🏛️</span> Sign In with Michigan SOS
      </button>

      <button class="retry-btn hidden" id="retryBtn" onclick="resetLogin()">
        ← Try a different account
      </button>

      <div class="lr-footer">
        <p>
          By signing in you agree to the MiCOURT Terms of Service. Your identity is verified through the Michigan Secretary of State identity registry and Roblox OAuth. MiCOURT does not store your Roblox credentials.
          <br><br>
          <a href="/micourt/help/">Need help signing in?</a> &nbsp;·&nbsp;
          <a href="/micourt/privacy/">Privacy Policy</a>
        </p>
      </div>
    </div>

  </div>
</div>

<footer>
  <p>© 2026 Michigan Courts · State Court Administrative Office · P.O. Box 30048, Lansing, MI 48909</p>
  <p style="color:#2a4a6a;">Portal v2.1 · Secured by Michigan SOS Identity Registry</p>
</footer>

